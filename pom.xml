<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.github.caiocv18</groupId>
    <artifactId>turnward-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>turnward</name>
    <description>Durable control plane for AI agents: human approval, per-tool authorization and token budgets that survive a crash.</description>
    <url>https://github.com/caiocv18/turnward</url>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>caiocv18</id>
            <name>Caio Vinicius</name>
            <url>https://github.com/caiocv18</url>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <url>https://github.com/caiocv18/turnward</url>
        <connection>scm:git:https://github.com/caiocv18/turnward.git</connection>
        <developerConnection>scm:git:git@github.com:caiocv18/turnward.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/caiocv18/turnward/issues</url>
    </issueManagement>

    <modules>
        <module>turnward-domain</module>
        <module>turnward-application</module>
        <module>turnward-adapter-web</module>
        <module>turnward-adapter-persistence</module>
        <module>turnward-adapter-kafka</module>
        <module>turnward-adapter-llm</module>
        <module>turnward-adapter-mcp-client</module>
        <module>turnward-adapter-mcp-server</module>
        <module>turnward-adapter-redis</module>
        <module>turnward-app</module>
    </modules>

    <properties>
        <java.version>25</java.version>

        <!-- Versions confirmed on 2026-10-18 (design note, section 11). Testcontainers 2.0.5 comes from the Boot BOM. -->
        <spring-ai.version>2.0.1</spring-ai.version>
        <resilience4j-spring-boot4.version>2.4.0</resilience4j-spring-boot4.version>
        <pact.version>4.7.5</pact.version>
        <testcontainers-keycloak.version>4.4.0</testcontainers-keycloak.version>
        <archunit.version>1.5.1</archunit.version>
        <jqwik.version>1.10.2</jqwik.version>
        <jacoco.version>0.8.15</jacoco.version>

        <!-- Coverage floor per module; domain and application raise it to 0.80. -->
        <jacoco.line.minimum>0.70</jacoco.line.minimum>
        <!-- Declared so -DskipTests also skips the coverage-data requirement below. -->
        <skipTests>false</skipTests>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.caiocv18</groupId>
                <artifactId>turnward-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.caiocv18</groupId>
                <artifactId>turnward-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.caiocv18</groupId>
                <artifactId>turnward-adapter-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.caiocv18</groupId>
                <artifactId>turnward-adapter-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.caiocv18</groupId>
                <artifactId>turnward-adapter-kafka</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.caiocv18</groupId>
                <artifactId>turnward-adapter-llm</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.caiocv18</groupId>
                <artifactId>turnward-adapter-mcp-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.caiocv18</groupId>
                <artifactId>turnward-adapter-mcp-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.caiocv18</groupId>
                <artifactId>turnward-adapter-redis</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Not listed in resilience4j-bom 2.4.0 (resilience4j#2427), so pinned here. -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot4</artifactId>
                <version>${resilience4j-spring-boot4.version}</version>
            </dependency>
            <dependency>
                <groupId>au.com.dius.pact.consumer</groupId>
                <artifactId>junit5</artifactId>
                <version>${pact.version}</version>
            </dependency>
            <dependency>
                <groupId>au.com.dius.pact.provider</groupId>
                <artifactId>spring7</artifactId>
                <version>${pact.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.dasniko</groupId>
                <artifactId>testcontainers-keycloak</artifactId>
                <version>${testcontainers-keycloak.version}</version>
            </dependency>
            <!-- Core only: rules run as plain Jupiter tests, so no ArchUnit engine meets the Boot-managed JUnit 6 platform. -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <!-- Built against JUnit Platform 1.14.4; the Boot BOM swaps in 6.0.3, so its engine is exercised by the domain build. -->
            <dependency>
                <groupId>net.jqwik</groupId>
                <artifactId>jqwik</artifactId>
                <version>${jqwik.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-baseline</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,26)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!-- Never let coverage from a previous run satisfy the gate. -->
                            <append>false</append>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            jacoco:check skips a module that produced no execution data, so a module with tests that
            never ran would pass the gate. Any module with src/test/java must produce jacoco.exec.
        -->
        <profile>
            <id>require-coverage-data</id>
            <activation>
                <file>
                    <exists>${project.basedir}/src/test/java</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>require-coverage-data</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <skip>${skipTests}</skip>
                                    <rules>
                                        <requireFilesExist>
                                            <files>
                                                <file>${project.build.directory}/jacoco.exec</file>
                                            </files>
                                            <message>Module has tests but no JaCoCo execution data: the coverage gate would be skipped.</message>
                                        </requireFilesExist>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
