<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.caiocv18</groupId>
        <artifactId>turnward-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>turnward-adapter-llm</artifactId>
    <name>turnward-adapter-llm</name>
    <description>Spring AI chat models (Ollama, Bedrock) behind Resilience4j.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.caiocv18</groupId>
            <artifactId>turnward-application</artifactId>
        </dependency>

        <!-- Compiled against Boot 4.0.0; CircuitBreakerSmokeTest proves it on the Boot 4.1 line. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
        </dependency>
        <!-- @CircuitBreaker is an aspect: without AOP the annotation is silently ignored. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
