<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.caiocv18</groupId>
        <artifactId>turnward-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>turnward-app</artifactId>
    <name>turnward-app</name>
    <description>Bootstrap: the only module that knows every adapter. Runs the api and worker roles by profile.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.caiocv18</groupId>
            <artifactId>turnward-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.caiocv18</groupId>
            <artifactId>turnward-application</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.caiocv18</groupId>
            <artifactId>turnward-adapter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.caiocv18</groupId>
            <artifactId>turnward-adapter-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.caiocv18</groupId>
            <artifactId>turnward-adapter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.caiocv18</groupId>
            <artifactId>turnward-adapter-llm</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.caiocv18</groupId>
            <artifactId>turnward-adapter-mcp-client</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.caiocv18</groupId>
            <artifactId>turnward-adapter-mcp-server</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.caiocv18</groupId>
            <artifactId>turnward-adapter-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <!-- The main method only delegates to SpringApplication; the profile tests cover the context. -->
                    <execution>
                        <id>report</id>
                        <configuration>
                            <excludes>
                                <exclude>io/github/caiocv18/turnward/TurnwardApplication.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check</id>
                        <configuration>
                            <excludes>
                                <exclude>io/github/caiocv18/turnward/TurnwardApplication.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
